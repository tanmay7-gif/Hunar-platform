{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@hunar/tinyfish": ["../tinyfish/src"],
      "@hunar/tinyfish/*": ["../tinyfish/src/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "../tinyfish/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
